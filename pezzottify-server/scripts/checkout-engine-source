#!/usr/bin/env bash
# CI/bootstrap helper; existing sibling checkouts are never rewritten.
set -euo pipefail
component="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
revision="$(cat "$component/simple-server.rev")"
[[ "$revision" =~ ^[0-9a-f]{40}$ ]] || exit 1
source_dir="$component/../../simple-server"
if [[ ! -e "$source_dir" ]]; then
    git init "$source_dir"
    git -C "$source_dir" remote add origin https://github.com/lelloman/simple-server.git
    git -C "$source_dir" fetch --depth=1 origin "$revision"
    git -C "$source_dir" checkout --detach FETCH_HEAD
fi
git -C "$source_dir" diff --exit-code "$revision" -- Cargo.toml Cargo.lock src crates
