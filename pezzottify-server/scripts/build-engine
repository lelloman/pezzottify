#!/usr/bin/env bash
# Build the exact pinned engine once; downstream builds reuse this artifact.
set -euo pipefail
component_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd -- "${component_dir}"
source_dir="${component_dir}/../../simple-server"
revision="$(cat simple-server.rev)"
[[ "${revision}" =~ ^[0-9a-f]{40}$ ]] || { echo 'invalid engine source revision' >&2; exit 1; }
target_dir="${component_dir}/target/engine-${revision}"
source_export="$(mktemp -d)"
trap 'rm -rf -- "${source_export}"' EXIT
git -C "${source_dir}" archive "${revision}" | tar -xf - -C "${source_export}"
cargo build --locked --release --manifest-path "${source_export}/crates/engine/Cargo.toml" --target-dir "${target_dir}"
printf '%s\n' "${revision}" > "${target_dir}/release/SOURCE_REVISION"
(cd "${target_dir}/release" && sha256sum libsimple_server_engine.so > SHA256SUMS)
echo "${target_dir}/release"
