#!/usr/bin/env bash
# Source from build/test scripts. Explicit artifacts need revision/checksum metadata.
pezzottify_component_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
pezzottify_revision="$(cat "${pezzottify_component_dir}/simple-server.rev")"
[[ "${pezzottify_revision}" =~ ^[0-9a-f]{40}$ ]] || { echo 'invalid engine source revision' >&2; return 1; }
pezzottify_source="${pezzottify_component_dir}/../../simple-server"
git -C "${pezzottify_source}" diff --quiet "${pezzottify_revision}" -- Cargo.toml Cargo.lock src crates || {
    echo 'simple-server bindings differ from simple-server.rev; check out the pinned source' >&2
    return 1
}
if [[ -z "${SIMPLE_SERVER_ENGINE_DIR:-}" ]]; then
    export SIMPLE_SERVER_ENGINE_DIR="${pezzottify_component_dir}/target/engine-${pezzottify_revision}/release"
    if [[ ! -f "${SIMPLE_SERVER_ENGINE_DIR}/libsimple_server_engine.so" ]]; then
        bash "${pezzottify_component_dir}/scripts/build-engine" >&2
    fi
fi
SIMPLE_SERVER_ENGINE_DIR="$(cd -- "${SIMPLE_SERVER_ENGINE_DIR}" && pwd)" || return 1
[[ "$(cat "${SIMPLE_SERVER_ENGINE_DIR}/SOURCE_REVISION")" == "${pezzottify_revision}" ]] || {
    echo 'engine artifact revision does not match simple-server.rev' >&2; return 1;
}
pezzottify_expected_sha="$(awk '$2 == "libsimple_server_engine.so" { print $1 }' "${SIMPLE_SERVER_ENGINE_DIR}/SHA256SUMS")"
[[ "${pezzottify_expected_sha}" =~ ^[0-9a-f]{64}$ ]] || { echo 'invalid engine checksum metadata' >&2; return 1; }
[[ "$(sha256sum "${SIMPLE_SERVER_ENGINE_DIR}/libsimple_server_engine.so" | cut -d' ' -f1)" == "${pezzottify_expected_sha}" ]] || {
    echo 'engine artifact checksum mismatch' >&2; return 1;
}
export SIMPLE_SERVER_ENGINE_DIR
pezzottify_install_engine() {
    local profile="$1"
    mkdir -p "${pezzottify_component_dir}/target/${profile}/lib"
    cp "${SIMPLE_SERVER_ENGINE_DIR}/libsimple_server_engine.so" "${pezzottify_component_dir}/target/${profile}/lib/libsimple_server_engine.so.1"
}
