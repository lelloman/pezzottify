#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
graph="$(cargo tree --locked --offline --edges normal,build --prefix none)"
if rg '^(axum|hyper|reqwest|rustls|tracing-subscriber)(-[^ ]*)? ' <<<"${graph}"; then
    echo 'unexpected host HTTP/runtime dependency' >&2; exit 1
fi
features="$(cargo tree --locked --offline --edges normal,build,features -i tokio)"
if rg 'tokio feature "(rt|rt-multi-thread|net|time|io-util|signal|full)"' <<<"${features}"; then
    echo 'host Tokio execution or I/O enabled' >&2; exit 1
fi
for binary in pezzottify-server build_search_index; do
    readelf -d "target/release/${binary}" | rg -F '[libsimple_server_engine.so.1]'
    readelf -d "target/release/${binary}" | rg -F '$ORIGIN/lib'
done
# Purely synchronous DB/search helpers do not adopt an unused runtime.
for binary in cli-auth query_search_index; do
    if readelf -d "target/release/${binary}" | rg -F '[libsimple_server_engine.so.1]'; then
        echo "unexpected engine adoption in ${binary}" >&2; exit 1
    fi
done
