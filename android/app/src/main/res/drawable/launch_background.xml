<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start window, shown while the Paravoid shell loads the payload (including after an
     update restart) instead of a blank white window. Pinned in the shell via Theme.Pezzottify. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item
        android:width="160dp"
        android:height="160dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />
</layer-list>
