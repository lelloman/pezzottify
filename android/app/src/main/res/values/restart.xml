<?xml version="1.0" encoding="utf-8"?>
<!-- Shell restart screen (paravoid updates.restartTheme). Everything referenced here is pinned in the
     shell: changing it requires a new shell. -->
<resources>
    <string name="restart_confirm_title">Restart to update?</string>
    <string name="restart_confirm_message">%1$s will close and reopen with the new version. Playback stops for a moment.</string>
    <string name="restart_confirm_button">Restart</string>
    <string name="restart_dismiss_button">Not now</string>
    <string name="restart_progress_title">Updating %1$s</string>
    <string name="restart_progress_message">The music will be back in a moment.</string>
    <string name="restart_failed_title">Restart unavailable</string>
    <string name="restart_failed_message">%1$s could not restart. You can try again from the update settings.</string>
    <string name="restart_close_button">Close</string>

    <style name="Theme.Pezzottify.Restart" parent="Base.Theme.Paravoid.Restart">
        <item name="android:colorBackground">@color/background_light</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="paravoidRestartConfirmTitle">@string/restart_confirm_title</item>
        <item name="paravoidRestartConfirmMessage">@string/restart_confirm_message</item>
        <item name="paravoidRestartConfirmButton">@string/restart_confirm_button</item>
        <item name="paravoidRestartDismissButton">@string/restart_dismiss_button</item>
        <item name="paravoidRestartProgressTitle">@string/restart_progress_title</item>
        <item name="paravoidRestartProgressMessage">@string/restart_progress_message</item>
        <item name="paravoidRestartFailedTitle">@string/restart_failed_title</item>
        <item name="paravoidRestartFailedMessage">@string/restart_failed_message</item>
        <item name="paravoidRestartCloseButton">@string/restart_close_button</item>
    </style>
</resources>
