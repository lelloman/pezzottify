# Android SDK location (auto-generated by Android Studio)
# sdk.dir=/path/to/android/sdk

# OIDC Configuration (required for SSO login)
oidc.issuerUrl=https://your-oidc-provider.com
oidc.clientId=your-client-id

# Server Configuration
# Without server.baseUrl the app starts on the emulator default (http://10.0.2.2:3001)
# and the login screens let the user change the server.
# Setting it pins the server: no server field is shown, previously saved hosts are
# ignored, and release builds require an HTTPS URL.
# server.baseUrl=https://music.example.com

# Assistant provider policy
# Builds are locked to SimpleAI by default. "user" explicitly enables runtime
# provider selection and configuration; another provider ID locks that provider.
# These can also be passed to Gradle, e.g. -Passistant.provider=ollama.
# assistant.provider=simpleai
# assistant.provider=user
# assistant.provider=ollama
# assistant.ollama.baseUrl=http://10.0.2.2:11434
# assistant.ollama.model=gpt-oss:20b
# assistant.ollama.timeoutSeconds=120
